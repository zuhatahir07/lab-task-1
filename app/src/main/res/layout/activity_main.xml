<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="140dp"
            android:layout_height="120dp"
            android:src="@drawable/uol_logo"
            android:contentDescription="University logo"
            android:scaleType="fitCenter"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="UOL Help Desk"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#1A5276"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="28dp" />

        <EditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="Your name"
            android:inputType="textPersonName"
            android:singleLine="true"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnWebsite"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Visit Website"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1A5276"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btnCall"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Call Help Desk"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1A5276"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btnMap"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Find Campus"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1A5276"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btnRequest"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Send a Request"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2E86C1"
            android:layout_marginTop="12dp" />

    </LinearLayout>
</ScrollView>